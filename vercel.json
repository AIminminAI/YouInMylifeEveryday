{
  "rewrites": [
    { "source": "/api/pay", "destination": "/api/pay.ts" },
    { "source": "/api/pay/:action", "destination": "/api/pay.ts?action=:action" },
    { "source": "/api/timeline", "destination": "/api/timeline.ts" },
    { "source": "/api/timeline/:action", "destination": "/api/timeline.ts?action=:action" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/*.ts": {
      "runtime": "@vercel/node@20"
    }
  }
}
