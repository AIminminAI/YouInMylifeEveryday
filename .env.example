# 生命星轨后端配置
# 复制此文件为 .env 并填入真实值

# 服务端口
PORT=3001

# JWT 密钥（生产环境请更换为随机长字符串）
JWT_SECRET=your-jwt-secret-change-me-in-production

# 微信支付配置（申请地址：https://pay.weixin.qq.com）
WECHAT_APP_ID=wx_your_app_id
WECHAT_MCH_ID=your_mch_id
WECHAT_API_KEY=your_api_key_v3
WECHAT_NOTIFY_URL=https://your-domain.com/api/pay/wechat/notify

# 支付宝配置（申请地址：https://open.alipay.com）
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_private_key
ALIPAY_PUBLIC_KEY=alipay_public_key
ALIPAY_NOTIFY_URL=https://your-domain.com/api/pay/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/pay/success

# Dify AI 配置（申请地址：https://dify.ai）
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-your-dify-api-key

# Coze AI 配置（备选，申请地址：https://coze.cn）
COZE_API_URL=https://api.coze.cn/v1
COZE_API_KEY=your_coze_api_key
COZE_BOT_ID=your_coze_bot_id

# 文件上传目录
UPLOAD_DIR=./uploads

# 数据库路径
DB_PATH=./data/starorbit.db
